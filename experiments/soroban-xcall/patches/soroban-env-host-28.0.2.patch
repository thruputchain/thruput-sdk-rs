+std::thread_local! {
+    static LAST_ESCALATED_ERROR: core::cell::Cell<Option<crate::Error>> =
+        const { core::cell::Cell::new(None) };
+}
+
+fn set_last_escalated_error(e: crate::Error) {
+    LAST_ESCALATED_ERROR.with(|c| c.set(Some(e)));
+}
+
+/// The host error most recently escalated to a panic by a natively compiled
+/// contract (see `escalate_error_to_panic`). An embedder that cannot unwind
+/// can read this from its panic hook to fail with the real error instead of a
+/// bare trap.
+pub fn take_last_escalated_error() -> Option<crate::Error> {
+    LAST_ESCALATED_ERROR.with(|c| c.take())
+}
+
+/// Routes calls to contracts that do not live in this host -- e.g. Soroban
+/// contracts hosted by *other* contracts of an embedding chain, or that
+/// chain's own contracts. Values cross the boundary as `ScVal`s.
+pub trait ExternalContractHandler {
+    /// Whether a call to `id` must be routed through [`Self::call`].
+    fn is_external(&self, id: &crate::xdr::ContractId) -> bool;
+    /// Perform the call. An `Err` behaves exactly like a failed callee: it
+    /// propagates to the caller, or is caught by `try_call`.
+    fn call(
+        &self,
+        id: &crate::xdr::ContractId,
+        func: &crate::xdr::ScSymbol,
+        args: std::vec::Vec<ScVal>,
+    ) -> Result<ScVal, crate::Error>;
+}
